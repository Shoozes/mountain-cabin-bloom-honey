export type MaterialFamily='grass'|'dirt'|'moss'|'cliff'|'stone'|'cobble'|'bark'|'timber'|'plaster'|'roof';
export type MaterialStyle='hd2d'|'cel-ink'|'soft-cartoon'|'pbr';
export type LegacyMaterialRecipe={id:'hd2d-cliff'|'hd2d-cliff-strata';seed:number;size:number;palette:string;strataScale:number;fracture:number;relief:number;roughness:number};
export type StyleSurfaceRecipe={id:'style-surface';family:MaterialFamily;style:MaterialStyle;structure?:'clumps'|'tufts';seed:number;size:number;palette:string;strataScale:number;fracture:number;relief:number;roughness:number};
export type RealisticFamily='soil'|'gravel'|'limestone'|'concrete'|'bark'|'timber';
export type RealisticSurfaceRecipe={id:'realistic-surface';family:RealisticFamily;seed:number;size:number;palette:string;strataScale:number;fracture:number;relief:number;roughness:number};
export type VoxelFamily='grass'|'dirt'|'stone'|'cobble'|'sand'|'planks'|'bark'|'brick';
export type VoxelSurfaceRecipe={id:'voxel-surface';family:VoxelFamily;seed:number;size:number;palette:string;strataScale:number;fracture:number;relief:number;roughness:number};
export type MaterialRecipe=LegacyMaterialRecipe|StyleSurfaceRecipe|RealisticSurfaceRecipe|VoxelSurfaceRecipe;
export const VOXEL_SURFACE_FAMILIES:readonly VoxelFamily[];
export const VOXEL_SURFACE_SIZES:readonly number[];
export const VOXEL_NATIVE_SIZE:16;
export const REALISTIC_SURFACE_FAMILIES:readonly RealisticFamily[];
export const REALISTIC_SURFACE_PRESETS:readonly {label:string;recipe:RealisticSurfaceRecipe}[];
export type MaterialPixels = {width:number;height:number;data:Uint8Array};
export const MATERIAL_VERSION:string;
export const MATERIAL_RECIPES:Record<MaterialRecipe['id'],string>;
export function materialVersion(id:MaterialRecipe['id']):string;
export const MATERIAL_DEFAULTS:LegacyMaterialRecipe;
export const MATERIAL_PALETTES:Record<string,string[]>;
export const STYLE_SURFACE_FAMILIES:readonly MaterialFamily[];
export const MATERIAL_STYLES:readonly MaterialStyle[];
export const STYLE_SURFACE_SIZES:Record<MaterialStyle,number>;
export const MATERIAL_CHANNELS:Record<string,{colorSpace:string;semantic:string}>;
export function validateMaterialRecipe(input?:unknown):MaterialRecipe;
export function sampleCliffStructure(input:unknown,u:number,v:number):Record<string,number>;
export function sampleSurfaceStructure(input:unknown,u:number,v:number):Record<string,number>;
export function generateMaterial(input?:unknown):{recipe:MaterialRecipe;channels:Record<string,MaterialPixels>;heights:Float32Array};
export function materialContactSheet(variants:ReturnType<typeof generateMaterial>[]):MaterialPixels;
